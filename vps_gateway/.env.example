# Copy to .env (NOT committed) and fill in.
# This file lives only on the VPS — secrets are safe here.

# Path to Hermes config root (default install: ~/.hermes)
HERMES_ROOT=/root/.hermes

# Supabase — same project Hermes already uses
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=eyJ...service-role-key...

# Single-user id, same one Hermes uses
USER_ID=11111111-1111-1111-1111-111111111111

# LLM provider — pick one of these two configurations
ANTHROPIC_API_KEY=sk-ant-...
# OR if you route via OpenRouter (matches the original Hermes config.yaml):
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.6

# Auth token the phone must present in the Authorization header
GATEWAY_TOKEN=generate-a-long-random-string-and-paste-here

# Optional: bind address. Default 127.0.0.1:8787 if behind a reverse proxy
HOST=127.0.0.1
PORT=8787
