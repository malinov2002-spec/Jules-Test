# Copy to .env and fill in. Variables prefixed EXPO_PUBLIC_ are bundled into the app.
# Do not put secrets you wouldn't want on a phone here — this is a single-user
# personal app, so a personal Anthropic key on your own device is acceptable.

# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key...

# ─── Coach backend ───────────────────────────────────────────────────────────
# Pick ONE of these two paths.
#
# Path A (recommended once your VPS gateway is up): the phone calls the
# Hermes VPS gateway, which holds the Anthropic key and shares state with the
# Telegram bot. Leave ANTHROPIC_API_KEY empty.
EXPO_PUBLIC_GATEWAY_URL=https://your-vps.example.com
EXPO_PUBLIC_GATEWAY_TOKEN=paste-the-same-GATEWAY_TOKEN-from-the-VPS-.env-here
#
# Path B (offline-friendly / pre-VPS): the phone calls Anthropic directly.
# Leave both EXPO_PUBLIC_GATEWAY_* empty and set this:
EXPO_PUBLIC_ANTHROPIC_API_KEY=

# Google OAuth client ID (Android type) for Google Tasks sync
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=YOUR-ID.apps.googleusercontent.com
# Web client ID is also required for Expo Go dev flow (auth proxy)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR-WEB-ID.apps.googleusercontent.com

# Single-user UUID — must match the seed in supabase/schema.sql
EXPO_PUBLIC_USER_ID=11111111-1111-1111-1111-111111111111
