# PostgreSQL overrides for Huginn's .env
# Reference only — setup.sh derives the real ./src/.env from upstream's
# .env.example and applies these values (plus a generated APP_SECRET_TOKEN).
# See ./src/.env.example for the full list of supported settings.

# Generate with: openssl rand -hex 64   (NEVER commit the real value)
APP_SECRET_TOKEN=REPLACE_ME_WITH_A_64_BYTE_HEX_SECRET

DATABASE_ADAPTER=postgresql
DATABASE_ENCODING=unicode
DATABASE_NAME=huginn_development
DATABASE_POOL=20
DATABASE_USERNAME=huginn
DATABASE_PASSWORD="huginn"
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432

PORT=3000
RAILS_ENV=development

# Invitation code required to register the first user (or skip it).
INVITATION_CODE=try-huginn
SKIP_INVITATION_CODE=false
